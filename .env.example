# Copie este arquivo para .env e preencha os valores.
# O .env fica fora do Git (.gitignore) e é lido pela API e pelo docker-compose.

# Banco de dados
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha
# Usado só ao rodar a API fora do Docker (./gradlew bootRun).
DB_URL=jdbc:postgresql://localhost:5432/finance

# Porta do Postgres no seu computador (mude se a 5432 já estiver em uso).
POSTGRES_PORT=5432

# Segredo do JWT: no mínimo 32 caracteres. Gere um com:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
# Validade do token em milissegundos (86400000 = 24 horas).
JWT_EXPIRATION=86400000
